# Everlasting Bloom Studio — example environment file
# Copy this to .env and fill in values locally.
# NEVER commit real secrets. .env is gitignored.

# Flask
FLASK_APP=app:create_app
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Security — CHANGE THESE before any deployment
SECRET_KEY=replace-with-a-long-random-string
SESSION_COOKIE_NAME=everlasting_bloom_session

# Database
DATABASE_URL=sqlite:////data/data/com.termux/files/home/Projects/crk_Projects/everlasting-bloom-studio/data/everlasting_bloom.db

# Uploads
MAX_CONTENT_LENGTH=16777216

# Hermes Agent integration (real interfaces only)
HERMES_CLI=hermes
HERMES_PROFILE=lilymogra-studio
HERMES_HOME=/data/data/com.termux/files/home/.hermes
HERMES_SERVE_PORT=9119
HERMES_SERVE_HOST=127.0.0.1
