#!/usr/bin/env python3
"""bloomctl — CLI companion for EVERLASTING BLOOM."""
import argparse
import sqlite3
import sys
import os

DB = os.path.join(os.path.dirname(__file__), 'everlasting_bloom.db')

def _db():
    conn = sqlite3.connect(DB)
    conn.row_factory = sqlite3.Row
    return conn

def cmd_version(args):
    print("EVERLASTING BLOOM — bloomctl v1.0")
    print("Unofficial tribute to White Lily Cookie. Some flowers never stop blooming.")

def cmd_letters(args):
    conn = _db()
    rows = conn.execute("SELECT id, author, message, approved FROM letters ORDER BY date_submitted DESC").fetchall()
    for r in rows:
        status = "✓" if r['approved'] else "✗ pending"
        print(f"[{status}] #{r['id']} — {r['author']}: {r['message'][:60]}...")
    conn.close()

def cmd_timeline(args):
    conn = _db()
    rows = conn.execute("SELECT id, title, date, category FROM milestones ORDER BY date DESC").fetchall()
    for r in rows:
        print(f"{r['date']} | {r['category']} | {r['title']}")
    conn.close()

def cmd_garden(args):
    conn = _db()
    count = conn.execute("SELECT COUNT(*) FROM garden_flowers").fetchone()[0]
    print(f"Garden flowers planted: {count}")
    conn.close()

def main():
    parser = argparse.ArgumentParser(description="EVERLASTING BLOOM CLI")
    sub = parser.add_subparsers(dest="cmd")
    sub.add_parser("version", help="Show version").set_defaults(func=cmd_version)
    sub.add_parser("letters", help="List letters").set_defaults(func=cmd_letters)
    sub.add_parser("timeline", help="List milestones").set_defaults(func=cmd_timeline)
    sub.add_parser("garden", help="Garden stats").set_defaults(func=cmd_garden)
    args = parser.parse_args()
    if not args.cmd:
        parser.print_help()
        sys.exit(1)
    args.func(args)

if __name__ == '__main__':
    main()
